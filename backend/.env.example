# Database Configuration (REQUIRED)
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=hospital_management
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Configuration (REQUIRED - Use strong random secret)
JWT_SECRET=your_strong_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN_DAYS=7

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# ABDM Configuration
ABDM_ENV=sandbox
ABDM_SANDBOX_CLIENT_ID=your_abdm_sandbox_client_id
ABDM_SANDBOX_CLIENT_SECRET=your_abdm_sandbox_client_secret
ABDM_PROD_CLIENT_ID=your_abdm_prod_client_id
ABDM_PROD_CLIENT_SECRET=your_abdm_prod_client_secret

# PMJAY Configuration
PMJAY_API_URL=https://hmis.pmjay.gov.in/api
PMJAY_BENEFICIARY_URL=https://hmis.pmjay.gov.in/api/beneficiary
PMJAY_CLAIM_URL=https://hmis.pmjay.gov.in/api/claim
PMJAY_CLIENT_ID=your_pmjay_client_id
PMJAY_CLIENT_SECRET=your_pmjay_client_secret
PMJAY_HOSPITAL_ID=your_pmjay_hospital_id

